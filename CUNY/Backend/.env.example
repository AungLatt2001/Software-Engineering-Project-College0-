# Copy this file to .env and adjust values.
# In production these should be set via your hosting provider's secret manager.

# Used to sign JWTs. MUST be set in production. If unset, a random key is
# generated on each boot — meaning every restart invalidates all sessions.
COLLEGE0_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives. Use a persistent volume in production
# (e.g. /data/college0.db on Render, /var/lib/college0/college0.db on a VM).
COLLEGE0_DB_PATH=college0.db

# Comma-separated list of allowed origins for CORS, or "*" for any.
# Set this to your frontend's deployed origin, e.g. https://college0.example.com
COLLEGE0_CORS_ORIGINS=*

# Port the backend listens on (gunicorn / Flask dev server)
# Note: macOS Airplay uses 5000, so we default to 5001
PORT=5001

# Set to "1" to enable Flask debug mode locally. NEVER set in production.
FLASK_DEBUG=0
